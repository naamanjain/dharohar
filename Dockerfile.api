# syntax=docker/dockerfile:1
# DHAROHAR API image — multi-stage: install deps -> esbuild compile -> slim runtime.
# Runs compiled ESM as a NON-ROOT user; no frontend source, no dev dependencies.

# ---- Stage 1: full dependency install (needed for esbuild) ----
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# ---- Stage 2: compile the TypeScript API to plain JS ----
FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY server ./server
# Bundle the server entrypoint AND the migration entrypoint; externals stay external.
RUN npm run build:server \
 && mkdir -p dist-server/db \
 && cp -r server/src/db/migrations dist-server/db/migrations

# ---- Stage 3: production dependencies only ----
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# ---- Stage 4: slim runtime ----
FROM node:22-alpine AS runtime
ENV NODE_ENV=production \
    PORT=3001
WORKDIR /app

COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist-server ./dist-server
COPY --chown=node:node package.json ./
COPY --chown=node:node deploy/entrypoint-api.sh ./deploy/entrypoint-api.sh
# The repo is edited on Windows; make sure the shell entrypoint is LF and executable.
RUN sed -i 's/\r$//' deploy/entrypoint-api.sh

USER node
EXPOSE 3001
ENTRYPOINT ["sh", "./deploy/entrypoint-api.sh"]
CMD ["node", "dist-server/index.js"]
