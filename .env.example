# DHAROHAR environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Backend (Express server, server/src) ---

# Runtime mode. In 'production' the server REFUSES to start without a unique JWT_SECRET,
# refuses ALLOWED_ORIGINS="*", and stops returning internal error messages to clients.
# NODE_ENV="production"

# MUST BE SET. Secret used to sign JWT access tokens. The prototype shipped a hardcoded
# secret that was also published in the README, so tokens could be forged for any role;
# that fallback is gone. In development an unset value now produces a random per-process
# secret, which means sessions do not survive a restart.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="jwt-secret-placeholder-CHANGE-ME-REQUIRED"

# Optional separate key for HMAC-signing verification seals. Defaults to JWT_SECRET.
# The seal signature is what makes a "verified" record non-forgeable from the audit log,
# so give it its own key if seals must stay verifiable after a JWT secret rotation.
# SEAL_SIGNING_KEY=""

# Access token lifetime in hours (default 24).
# JWT_EXPIRY_HOURS="24"

# Port for the Express API server (default 3001; must match the Vite dev proxy target).
PORT="3001"

# Comma-separated list of allowed CORS origins. Unset allows the local dev origins only.
# The old code computed this list and then answered "allow" to every origin; that is fixed,
# so an origin missing from this list now genuinely gets no CORS grant.
# "*" is permitted in development and rejected in production.
# ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Set to 'true' only when running behind a reverse proxy (Cloud Run, nginx) so req.ip is the
# real client IP for the login throttle.
# TRUST_PROXY="false"

# Full PostgreSQL connection string. If unset, connection parameters come from the PG*
# variables below (read natively by the pg driver). If the database is unreachable the
# server falls back to an in-memory store that loses everything on restart.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/dharohar_db"

# Individual PostgreSQL connection parameters (used when DATABASE_URL is not set).
# There are no longer any default username/password fallbacks: wrong credentials now fail
# loudly instead of silently connecting to some other local database.
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="change-me"
PGDATABASE="dharohar_db"

# --- Frontend (Vite, src/) ---

# Base URL the browser API client uses. Default '/api' (relative), which the Vite
# dev server proxies to the backend. Set to an absolute URL in deployed builds.
# VITE_API_BASE="/api"

# Where the Vite dev proxy forwards '/api' requests. Default http://localhost:3001.
# VITE_API_PROXY_TARGET="http://localhost:3001"

# Set to 'true' to disable HMR and file watching (agent-edit/AI-Studio optimization).
# DISABLE_HMR="false"

# --- One-time administrator bootstrap (npm run db:bootstrap-admin) ---
#
# Run once against a migrated database to create the first officer who can provision the rest.
# There is no self-registration anywhere in this application, and the command REFUSES to run when
# somebody already holds the USER_ADMIN capability (exit 4, nothing written) so it can never be used
# to reset or back-door an existing deployment.
#
# BOOTSTRAP_ADMIN_EMAIL="you@department.example"
# BOOTSTRAP_ADMIN_NAME="First System Administrator"
# BOOTSTRAP_ADMIN_DISTRICT="Jaipur"        # this officer's jurisdiction, not a guess
# BOOTSTRAP_ADMIN_ROLE="TEHSILDAR"         # optional; one of the four CHECK-constrained roles
# BOOTSTRAP_ADMIN_ID="USR-SYSADM-01"       # optional
# BOOTSTRAP_ADMIN_BADGE="RJ-REV-2026-0001" # optional
# BOOTSTRAP_ORG_NAME="Rajasthan Revenue Department" # optional; creates the organizations row
#
# Supply your own password and it is never echoed. If this is unset, a strong one is generated and
# printed exactly once — record it immediately, it is not stored anywhere readable.
# BOOTSTRAP_ADMIN_PASSWORD="at least 10 characters"

# --- Least-privilege database role (scripts/roles.sql) ---
#
# The API can run as `dharohar_app` instead of the PostGIS container's superuser: non-superuser,
# NOBYPASSRLS, no CREATE anywhere, no DELETE on any record table except parcel_owners, and
# INSERT-only on the audit chain. Verified: the whole authorization suite passes through it.
# The password is passed to psql as a variable and never written to a file in this repository:
#   DHAROHAR_APP_PASSWORD="$(openssl rand -base64 32)"

