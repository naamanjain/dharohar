# syntax=docker/dockerfile:1
# DHAROHAR web image — multi-stage: Vite build -> nginx static + /api reverse proxy.

# ---- Stage 1: build the React SPA ----
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Overridable at build time; defaults to relative /api so nginx proxies it.
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build

# Fail the build if the self-hosted OCR assets did not reach dist/ (Vite copies public/
# verbatim) or if the bundle lost the same-origin wiring. See public/tesseract/PROVENANCE.md.
#
# Why a targeted grep rather than a blanket "no jsdelivr anywhere": tesseract.js keeps its
# own CDN defaults as reachable-but-overridden strings — in the main bundle
# (src/worker/browser/defaultOptions.js, folded in as {...defaultOptions, ..._options}) and
# in the worker script (src/worker-script/browser/getCore.js and worker-script/index.js
# `loadLanguage`, both `param || CDN`). Our workerPath/corePath/langPath win in every case,
# and the browser network log confirms no CDN request is made. The strings cannot be
# tree-shaken without patching node_modules, so the assertion checks the origins that would
# actually change behaviour and the exact override we rely on.
RUN set -eu; \
    for f in \
      dist/tesseract/worker.min.js \
      dist/tesseract/core/tesseract-core-lstm.wasm.js \
      dist/tesseract/core/tesseract-core-simd-lstm.wasm.js \
      dist/tesseract/core/tesseract-core-relaxedsimd-lstm.wasm.js \
      dist/tesseract/lang/eng.traineddata.gz \
      dist/tesseract/lang/hin.traineddata.gz; do \
        test -s "$f" || { echo "MISSING required OCR asset: $f"; exit 1; }; \
    done; \
    grep -q '/tesseract' dist/assets/*.js \
      || { echo 'FAIL: bundle no longer points the Tesseract paths at our own origin'; exit 1; }; \
    if grep -rIl -e 'tessdata.projectnaptha.com' -e '@tesseract.js-data' dist/assets; then \
        echo 'FAIL: main bundle references a CDN traineddata origin'; exit 1; \
    fi; \
    jsdelivr_hits=$(grep -o 'cdn\.jsdelivr\.net' dist/assets/*.js | wc -l); \
    if [ "$jsdelivr_hits" -gt 1 ]; then \
        echo "FAIL: unexpected CDN references in bundle (jsdelivr hits: $jsdelivr_hits, expected <=1 dead default)"; exit 1; \
    fi; \
    echo 'OCR asset self-hosting check passed.'

# ---- Stage 2: serve with nginx ----
FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
