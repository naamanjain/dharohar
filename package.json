{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist','server.js'])fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "server": "tsx server/src/index.ts",
    "build:server": "esbuild server/src/index.ts server/src/db/migrate.ts server/src/db/seed.ts server/src/db/bootstrapAdmin.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist-server",
    "start:prod": "node dist-server/index.js",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "db:seed": "tsx server/src/db/seed.ts",
    "db:bootstrap-admin": "tsx server/src/db/bootstrapAdmin.ts",
    "test": "npm run test:i18n && npm run test:ocr && npm run test:phase4 && npm run test:e2e",
    "test:i18n": "tsx server/src/verify_i18n.ts",
    "test:ocr": "tsx server/src/verify_ocr.ts",
    "test:phase4": "tsx server/src/test_phase4_suite.ts",
    "test:e2e": "tsx server/src/test_e2e_suite.ts",
    "test:api": "tsx server/src/test_api.ts",
    "test:integration": "tsx server/src/test_integration.ts",
    "test:api-suite": "tsx server/src/verify_api_suite.ts",
    "test:db": "npm run test:api && npm run test:integration && npm run test:api-suite",
    "test:jurisdiction": "tsx server/src/test_jurisdiction_suite.ts",
    "test:provisioning": "tsx server/src/test_provisioning_suite.ts",
    "test:integrity": "tsx server/src/verify_district_integrity.ts",
    "test:integrity-gate": "tsx server/src/test_integrity_gate.ts",
    "test:registry": "tsx server/src/test_district_registry_suite.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
